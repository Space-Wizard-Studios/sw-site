---
import { cn } from '@lib/utils';
import { Image } from 'astro:assets';
import { NeonCard } from '@common/NeonCard';
import astronautImg from '@assets/images/astronaut_contact.jpeg';

export interface Props {
    className?: string;
}

const { className } = Astro.props as Props;
---

<div class={cn('flex my-8', className)}>
    <div class='w-full flex'>
        <NeonCard client:visible>
        <div
            class={cn(
                'flex h-full w-full flex-row overflow-hidden rounded-2xl',
                'bg-radial-[at_15%_15%]',
                'from-surface-container-low/60 to-surface-container/60',
                'text-on-surface backdrop-blur-md',
                'transition-shadow duration-300',
                'hover:shadow-primary/10 shadow-xl',
            )}
        >
            <div class='hidden md:block md:w-1/2 lg:w-2/5 relative overflow-hidden'>
                <Image
                    src={astronautImg}
                    alt='Astronauta com celular'
                    class='h-full w-full object-cover dark:hue-rotate-33'
                    loading='lazy'
                />
            </div>
            <div class='flex flex-col gap-6 p-8 w-full md:w-1/2 lg:w-3/5 justify-center'>
                <h4 class='text-on-surface/80 font-semibold'>Escolha o melhor canal para falar com a gente</h4>

                <div class='flex flex-col gap-4'>
                    <a
                        href='mailto:contato@spacewiz.dev'
                        class='flex items-center gap-4 rounded-xl p-4 no-underline bg-surface-container/50 hover:bg-surface-container transition-colors'
                    >
                        <div class='flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary'>
                            <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='16' x='2' y='4' rx='2'/><path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'/></svg>
                        </div>
                        <div class='flex flex-col'>
                            <span class='font-semibold text-sm'>Email</span>
                            <span class='text-on-surface/70 text-sm'>contato@spacewiz.dev</span>
                        </div>
                    </a>

                    <a
                        href='https://wa.me/5561993527377'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='flex items-center gap-4 rounded-xl p-4 no-underline bg-surface-container/50 hover:bg-surface-container transition-colors'
                    >
                        <div class='flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary'>
                            <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>
                        </div>
                        <div class='flex flex-col'>
                            <span class='font-semibold text-sm'>WhatsApp</span>
                            <span class='text-on-surface/70 text-sm'>Envie uma mensagem</span>
                        </div>
                    </a>

                    <a
                        href='https://www.instagram.com/spacewiz.dev/'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='flex items-center gap-4 rounded-xl p-4 no-underline bg-surface-container/50 hover:bg-surface-container transition-colors'
                    >
                        <div class='flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary'>
                            <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='20' x='2' y='2' rx='5' ry='5'/><path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'/><line x1='17.5' x2='17.51' y1='6.5' y2='6.5'/></svg>
                        </div>
                        <div class='flex flex-col'>
                            <span class='font-semibold text-sm'>Instagram</span>
                            <span class='text-on-surface/70 text-sm'>@spacewiz.dev</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        </NeonCard>
    </div>
</div>
