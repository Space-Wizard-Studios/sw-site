---
import Layout from '@layouts/PageLayout.astro';
import { getAllProjects } from '@lib/collections/projectHelpers';
import { ProjectsPageContent } from '@common/ProjectsGallery/ProjectsPageContent';

import type { metaSEO } from '@schemas/common/seoSchema';

const constructedSeo: metaSEO = {
    title: 'Projetos',
    description: 'Um gostinho do que fazemos',
    canonical: Astro.url.toString(),
    robots: {
        noindex: undefined,
        nofollow: undefined,
    },
    og: {
        title: 'Projetos',
        description: 'Um gostinho do que fazemos',
        type: 'website',
        image: undefined,
    },
};

const projects = await getAllProjects();
---

<Layout seo={constructedSeo}>
    <section class='flex flex-col w-full relative pb-12'>
        <div class='sw-container flex flex-col space-y-10'>
            <div class='flex flex-col py-8 space-y-4'>
                <ProjectsPageContent client:only="react" projects={projects} />
            </div>
        </div>
    </section>
</Layout>
